# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.swarm/
ruvector.db
*.db-shm
*.db-wal
.claude/settings.json.bak-*
# Ruflo runtime state written by its hooks and daemon
.claude-flow/daemon-state.json
.claude-flow/daemon.pid
.claude-flow/harness-active-policy.json
.claude-flow/metrics/
.claude-flow/policy/
.claude-flow/security/
.claude/.proven-config-version
.claude/proven-config.json

# Reference screenshots of the original app (replica-recon/design). Local only, never committed or shipped.
replica/screens/
# Layout diff images contain (dimmed) pixels of the original app: local only, like replica/screens/.
replica/diffs/*.png

# Ruflo session state when a hook runs from a subfolder
apps/web/.claude-flow/
