//@version=6
// Indicator version of the "SOL Donchian OOS 2025-2026" strategy.
// Enters on a Donchian breakout in the direction of the trend SMA when ATR is above its average.
// Only one position at a time. Exits on an ATR trailing stop or an ATR hard stop loss,
// emulating strategy.exit(trail_points, trail_offset, loss) on bar highs/lows.
indicator("SOL Donchian Indicator", overlay=true)

atrLen         = input.int(14, "ATR Length")
atrMult        = input.float(0.02, "ATR Trail Mult", step=0.01)
stopMult       = input.float(1.5, "Hard SL ATR Mult", step=0.1)
smaLen         = input.int(200, "Trend SMA")
breakoutLen    = input.int(20, "Donchian Breakout Lookback")
volLen         = input.int(20, "Volatility Average Length")
riskPct        = input.float(0.25, "Risk %", minval=0.05, maxval=1.0, step=0.05)
maxNotionalPct = input.float(50.0, "Max Notional %", minval=10.0, maxval=100.0, step=5.0)
showBg         = input.bool(true, "Shade Background While In Position")

grpDash  = "Dashboard"
showDash = input.bool(true, "Show Dashboard", group=grpDash)
dashPos  = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpDash)
dashSize = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal"], group=grpDash)
initCap  = input.float(25000, "Initial Capital", minval=1, group=grpDash)
commPct  = input.float(0.05, "Commission % (per side)", minval=0.0, step=0.01, group=grpDash)

sma    = ta.sma(close, smaLen)
atr    = ta.atr(atrLen)
atrAvg = ta.sma(atr, volLen)
hi     = ta.highest(high, breakoutLen)[1]
lo     = ta.lowest(low, breakoutLen)[1]

longC  = close > hi and close > sma and atr > atrAvg
shortC = close < lo and close < sma and atr > atrAvg

// The strategy re-places its exit at every bar close, so the stops active on this bar
// use the previous bar's ATR.
trailDist     = atr * atrMult
stopDist      = atr * stopMult
trailDistPrev = nz(trailDist[1], trailDist)
stopDistPrev  = nz(stopDist[1], stopDist)

var float equity     = initCap   // closed-trade equity in cash
var int   pos        = 0         // 1 = long, -1 = short, 0 = flat
var float posQty     = na
var float entryPrice = na
var float extreme    = na        // highest high (long) / lowest low (short) since entry
var bool  trailOn    = false
var float trailStop  = na
var float hardStop   = na

bool   exitLong  = false
bool   exitShort = false
float  closedPnl = na            // cash P&L of a trade closed on this bar
float  closedRet = na            // % return on the trade's notional
string exitType  = ""

// --- Manage exits for an open position (bars after entry) ---
if pos == 1
    hardStop := entryPrice - stopDistPrev
    extreme  := math.max(extreme, high)
    if not trailOn and extreme >= entryPrice + trailDistPrev
        trailOn := true
    trailStop := trailOn ? extreme - trailDistPrev : na
    float stopLvl = trailOn ? math.max(trailStop, hardStop) : hardStop
    if low <= stopLvl
        float fill = math.min(open, stopLvl)
        exitLong  := true
        exitType  := trailOn and trailStop >= hardStop ? "Trail" : "SL"
        closedPnl := posQty * (fill - entryPrice) - posQty * (entryPrice + fill) * commPct / 100
        closedRet := closedPnl / (posQty * entryPrice) * 100
        pos       := 0
else if pos == -1
    hardStop := entryPrice + stopDistPrev
    extreme  := math.min(extreme, low)
    if not trailOn and extreme <= entryPrice - trailDistPrev
        trailOn := true
    trailStop := trailOn ? extreme + trailDistPrev : na
    float stopLvl = trailOn ? math.min(trailStop, hardStop) : hardStop
    if high >= stopLvl
        float fill = math.max(open, stopLvl)
        exitShort := true
        exitType  := trailOn and trailStop <= hardStop ? "Trail" : "SL"
        closedPnl := posQty * (entryPrice - fill) - posQty * (entryPrice + fill) * commPct / 100
        closedRet := closedPnl / (posQty * entryPrice) * 100
        pos       := 0

if not na(closedPnl)
    equity := equity + closedPnl

// --- Entries (only when flat, filled at bar close like process_orders_on_close=true) ---
float qty = math.min(equity * riskPct / 100.0 / stopDist, equity * maxNotionalPct / 100.0 / close)

bool enterLong  = false
bool enterShort = false

if pos == 0 and qty > 0
    if longC
        enterLong := true
        pos       := 1
    else if shortC
        enterShort := true
        pos        := -1
    if enterLong or enterShort
        posQty     := qty
        entryPrice := close
        extreme    := close
        trailOn    := false
        trailStop  := na
        hardStop   := enterLong ? close - stopDist : close + stopDist

if pos == 0
    posQty     := na
    entryPrice := na
    extreme    := na
    trailOn    := false
    trailStop  := na
    hardStop   := na

// --- Plots ---
plot(sma, "Trend SMA", color=color.purple, linewidth=2)
plot(hi,  "Donchian High", color=color.new(color.teal, 40))
plot(lo,  "Donchian Low",  color=color.new(color.maroon, 40))
plot(entryPrice, "Entry Price", color=color.gray, style=plot.style_linebr)
plot(hardStop,   "Hard Stop",   color=color.red, style=plot.style_linebr, linewidth=2)
plot(trailOn ? trailStop : na, "Trail Stop", color=color.orange, style=plot.style_linebr, linewidth=2)

plotshape(enterLong,  "Long Entry",  shape.triangleup,   location.belowbar, color.green, text="Long",  textcolor=color.green, size=size.small)
plotshape(enterShort, "Short Entry", shape.triangledown, location.abovebar, color.red,   text="Short", textcolor=color.red,   size=size.small)
plotshape(exitLong,  "Long Exit",  shape.xcross, location.abovebar, color.orange, text="LX", textcolor=color.orange, size=size.tiny)
plotshape(exitShort, "Short Exit", shape.xcross, location.belowbar, color.orange, text="SX", textcolor=color.orange, size=size.tiny)

bgcolor(showBg and pos == 1 ? color.new(color.green, 92) : showBg and pos == -1 ? color.new(color.red, 92) : na)

// --- Trade statistics ---
var int   totalTrades = 0
var int   wins        = 0
var int   losses      = 0
var int   longTrades  = 0
var int   longWins    = 0
var int   shortTrades = 0
var int   shortWins   = 0
var int   trailExits  = 0
var int   slExits     = 0
var float grossWin    = 0.0
var float grossLoss   = 0.0
var float sumRet      = 0.0
var float peakEquity  = initCap
var float maxDD       = 0.0
var int   streak      = 0       // >0 consecutive wins, <0 consecutive losses
var int   maxWinStrk  = 0
var int   maxLossStrk = 0

if not na(closedPnl)
    bool isWin = closedPnl > 0
    totalTrades += 1
    sumRet      += closedRet
    if exitLong
        longTrades += 1
        longWins   += isWin ? 1 : 0
    else
        shortTrades += 1
        shortWins   += isWin ? 1 : 0
    if exitType == "Trail"
        trailExits += 1
    else
        slExits += 1
    if isWin
        wins     += 1
        grossWin += closedPnl
        streak   := streak > 0 ? streak + 1 : 1
    else
        losses    += 1
        grossLoss += math.abs(closedPnl)
        streak    := streak < 0 ? streak - 1 : -1
    maxWinStrk  := math.max(maxWinStrk, streak)
    maxLossStrk := math.max(maxLossStrk, -streak)
    peakEquity  := math.max(peakEquity, equity)
    maxDD       := math.max(maxDD, (peakEquity - equity) / peakEquity * 100)

// --- Dashboard ---
pct(x) => na(x) ? "n/a" : str.tostring(x, "#.##") + "%"
cash(x) => na(x) ? "n/a" : (x < 0 ? "-$" : "$") + str.tostring(math.abs(x), "#,##0.00")
rate(int w, int n) => n > 0 ? float(w) / n * 100.0 : na
pnlColor(x) => na(x) ? color.gray : x >= 0 ? color.green : color.red

tblPos = switch dashPos
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right
txtSize = switch dashSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table dash = table.new(tblPos, 2, 18, bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 60), border_width=1)

addRow(int r, string label, string value, color valColor) =>
    table.cell(dash, 0, r, label, text_color=color.silver, text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, r, value, text_color=valColor,     text_size=txtSize, text_halign=text.align_right)

if showDash and barstate.islast
    float winRate  = rate(wins, totalTrades)
    float netPnl   = equity - initCap
    float netPct   = netPnl / initCap * 100
    float pf       = grossLoss > 0 ? grossWin / grossLoss : na
    float avgWin   = wins > 0 ? grossWin / wins : na
    float avgLoss  = losses > 0 ? -grossLoss / losses : na
    float avgTrade = totalTrades > 0 ? netPnl / totalTrades : na
    float avgRet   = totalTrades > 0 ? sumRet / totalTrades : na
    float openPnl  = pos != 0 ? pos * posQty * (close - entryPrice) : na
    string posTxt  = pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT"
    color  posCol  = pos == 1 ? color.green : pos == -1 ? color.red : color.gray

    table.cell(dash, 0, 0, "SOL Donchian Stats", text_color=color.white, text_size=txtSize, bgcolor=color.new(color.blue, 40))
    table.cell(dash, 1, 0, "", bgcolor=color.new(color.blue, 40))
    table.merge_cells(dash, 0, 0, 1, 0)
    addRow(1,  "Total Trades",   str.tostring(totalTrades), color.white)
    addRow(2,  "Wins / Losses",  str.tostring(wins) + " / " + str.tostring(losses), color.white)
    addRow(3,  "Win Rate",       pct(winRate), na(winRate) ? color.gray : winRate >= 50 ? color.green : color.red)
    addRow(4,  "Long Win Rate",  pct(rate(longWins, longTrades)) + " (" + str.tostring(longTrades) + ")", color.white)
    addRow(5,  "Short Win Rate", pct(rate(shortWins, shortTrades)) + " (" + str.tostring(shortTrades) + ")", color.white)
    addRow(6,  "Net Profit",     cash(netPnl) + " (" + pct(netPct) + ")", pnlColor(netPnl))
    addRow(7,  "Equity",         cash(equity), color.white)
    addRow(8,  "Profit Factor",  na(pf) ? "n/a" : str.tostring(pf, "#.##"), na(pf) ? color.gray : pf >= 1 ? color.green : color.red)
    addRow(9,  "Avg Trade",      cash(avgTrade) + " (" + pct(avgRet) + ")", pnlColor(avgTrade))
    addRow(10, "Avg Win",        cash(avgWin), color.green)
    addRow(11, "Avg Loss",       cash(avgLoss), color.red)
    addRow(12, "Max Drawdown",   pct(-maxDD), maxDD > 0 ? color.red : color.gray)
    addRow(13, "Max Win/Loss Streak", str.tostring(maxWinStrk) + " / " + str.tostring(maxLossStrk), color.white)
    addRow(14, "Exits Trail / SL", str.tostring(trailExits) + " / " + str.tostring(slExits), color.white)
    addRow(15, "Position",       posTxt, posCol)
    addRow(16, "Position Size",  pos != 0 ? str.tostring(posQty, "#.####") : "-", color.white)
    addRow(17, "Open P&L",       cash(openPnl), pnlColor(openPnl))

// --- Alerts ---
alertcondition(enterLong,  "Long Entry",  "SOL Donchian: Long entry on {{ticker}} at {{close}}")
alertcondition(enterShort, "Short Entry", "SOL Donchian: Short entry on {{ticker}} at {{close}}")
alertcondition(exitLong,   "Long Exit",   "SOL Donchian: Long exit on {{ticker}}")
alertcondition(exitShort,  "Short Exit",  "SOL Donchian: Short exit on {{ticker}}")
