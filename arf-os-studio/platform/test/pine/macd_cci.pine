//@version=6
strategy("MACD-CCI ctrl", overlay=true, pyramiding=1, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.05, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
cci = ta.cci(close, 20)
atr = ta.atr(14)
longCondition = ta.crossover(macdLine, signalLine) and cci > 0
shortCondition = ta.crossunder(macdLine, signalLine) and cci < 0
if longCondition
    strategy.entry("Long", strategy.long)
if shortCondition
    strategy.entry("Short", strategy.short)
trailDist = atr * 0.015 / syminfo.mintick
strategy.exit("Long Exit", from_entry="Long", trail_points=trailDist, trail_offset=trailDist)
strategy.exit("Short Exit", from_entry="Short", trail_points=trailDist, trail_offset=trailDist)
