{
 "_about": "replica-entrepreneur themes, extended for price-forecast and trading-signal apps. Patterns are case-insensitive Python regexes.",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
 ],
 "themes": [
  {
   "id": "accuracy",
   "label": "Signals and forecasts are wrong, users lose money",
   "kind": "complaint",
   "patterns": [
    "\\binaccurate\\b",
    "\\bnot accurate\\b",
    "\\bnot very accurate\\b",
    "\\bwrong\\b",
    "\\blost (money|\\$|a lot|my)",
    "\\blose money\\b",
    "\\blosing money\\b",
    "\\bopposite\\b",
    "\\bcoin ?flip\\b",
    "\\brandom\\b",
    "\\bfake\\b",
    "\\bgarbage\\b",
    "\\buseless\\b",
    "\\bterrible (picks|signals|predictions)\\b",
    "\\bdon'?t work\\b",
    "\\bnever (right|correct|hit)\\b",
    "\\bwent down\\b",
    "\\bdropped\\b"
   ]
  },
  {
   "id": "proof",
   "label": "No track record or proof of results",
   "kind": "request",
   "patterns": [
    "\\btrack record\\b",
    "\\bwin rate\\b",
    "\\bwin ?ratio\\b",
    "\\bproof\\b",
    "\\bbacktest",
    "\\bhistory of (its|their|the) (picks|signals|calls)\\b",
    "\\bpast (picks|signals|performance|predictions)\\b",
    "\\btransparen",
    "\\bhow accurate\\b",
    "\\baccuracy\\b",
    "\\bverif"
   ]
  },
  {
   "id": "late",
   "label": "Signals arrive late",
   "kind": "complaint",
   "patterns": [
    "\\btoo late\\b",
    "\\blate\\b",
    "\\bdelay(ed|s)?\\b",
    "\\bafter the (move|fact|pump|jump)\\b",
    "\\balready (moved|up|down|gone)\\b",
    "\\bbehind\\b"
   ]
  },
  {
   "id": "explain",
   "label": "No explanation of why",
   "kind": "request",
   "patterns": [
    "\\bexplain",
    "\\bexplanation\\b",
    "\\breasoning\\b",
    "\\bwhy (it|they|the app) (says|recommends|picks)\\b",
    "\\bno context\\b",
    "\\bblack box\\b"
   ]
  },
  {
   "id": "scam",
   "label": "Called a scam outright",
   "kind": "complaint",
   "patterns": [
    "\\bscam",
    "\\brip.?off\\b",
    "\\bfraud\\b",
    "\\bcon\\b",
    "\\bthieves\\b",
    "\\bsteal"
   ]
  },
  {
