{
  "_about": "Design tokens for the forecast-signals clone. Roles measured from BeCoin's public pages (replica/screens/, 2026-10-21) and consolidated; values set by /replica-brand (Proofcast: plum accent, warm neutrals; see replica/brand.md). Names stay, values change. Check with: python3 contrast.py replica/design/tokens.json",
  "_measured": {
    "fonts_seen": "5 families (geometric sans for UI, a second display sans, a monospace for numbers, a high-contrast serif for hero headlines, plus a fallback) -> consolidated to 1 sans + 1 mono",
    "greys_seen": "about 9 text greys across two sub-palettes (cool navy greys on hub/pricing, warm greys on asset pages) -> 3 text roles",
    "page_bgs_seen": "6 near-white tints -> bg + surface + surface-sunken",
    "accent_seen": "an indigo/periwinkle brand accent (header gradient, primary buttons, active tabs) and a separate mid-blue on asset pages -> one accent role, placeholder value here (original measured at hue ~233, e.g. #5363df; ours is plum, hue ~322)",
    "spacing_seen": "2-28px with odd steps (9, 10, 13, 18, 22) -> 4px base scale",
    "radius_seen": "4, 6, 8, 10, 12, 14, 16, 20, 24, 999 -> sm/md/lg/xl/pill",
    "layout_seen": "header ~70px; content max 1200px; wide table container ~1360px; prose ~800px; mobile gutter 16px",
    "motion_seen": "100-200ms ease transitions on hover/press"
  },
