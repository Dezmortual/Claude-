# Copy to .env.local (never committed) and fill in. Every variable the server reads is listed here.

# Postgres connection string. Supabase: Project settings > Database > Connection string (use the pooled one on Vercel).
DATABASE_URL=

# Public URL of the app, used in email links. http://localhost:3000 locally.
APP_URL=http://localhost:3000

# Comma-separated email(s) allowed to sign up and sign in. Everyone else is turned away.
OWNER_EMAILS=

# true: the whole app is behind sign-in and only OWNER_EMAILS get in, with every feature, free.
PRIVATE_MODE=true

# Resend API key for verification, reset and alert emails. Without a verified domain, Resend only delivers to the
# address you signed up to Resend with; set that as your owner email. Leave empty locally: emails go to .data/outbox/.
RESEND_API_KEY=
# Local testing of a production build only: write emails to .data/outbox/ instead of sending.
EMAIL_OUTBOX=false
# Sender. onboarding@resend.dev works without a domain; use your own once it is verified in Resend.
EMAIL_FROM=Forecasts <onboarding@resend.dev>

# Shared secret for the scheduled jobs (/api/cron/*). At least 24 random characters: openssl rand -base64 32
CRON_SECRET=

# Optional: free Alpaca account keys for real US stock and ETF prices. Without them those markets use demo data.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
