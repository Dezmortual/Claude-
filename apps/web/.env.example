# Copy to .env.local (never committed) and fill in. Every variable the server reads is listed here.

# Postgres connection string. Supabase: Project settings > Database > Connection string (use the pooled one on Netlify or Vercel).
DATABASE_URL=

# Public URL of the app, used in email links. Optional on Vercel and Netlify (taken from the host), localhost otherwise.
APP_URL=http://localhost:3000

# Comma-separated email(s) allowed to sign up and sign in. Everyone else is turned away.
OWNER_EMAILS=

# true: the whole app is behind sign-in and only OWNER_EMAILS get in, with every feature, free.
PRIVATE_MODE=true

# Resend API key for verification, reset and alert emails. Without a verified domain, Resend only delivers to the
# address you signed up to Resend with; set that as your owner email. Leave empty locally: emails go to .data/outbox/.
RESEND_API_KEY=
# Local testing of a production build only: write emails to .data/outbox/ instead of sending.
EMAIL_OUTBOX=false
# Sender. onboarding@resend.dev works without a domain; use your own once it is verified in Resend.
EMAIL_FROM=Proofcast <onboarding@resend.dev>

# Forex candles with real highs and lows, 5-minute to weekly (free key at twelvedata.com, 800 credits a day; the app
# uses about 312). Without it, forex uses the ECB's daily reference rates: line charts only, no intraday.
TWELVE_DATA_API_KEY=

# Web push for alerts (the installable app). Generate a pair once: npx web-push generate-vapid-keys
# Leave both empty to switch push off; alerts then go by email only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for the scheduled jobs (/api/cron/*). At least 24 random characters: openssl rand -base64 32
CRON_SECRET=

# Self-hosting behind your own reverse proxy that sets X-Forwarded-For: true. Leave unset otherwise (and on Vercel).
TRUST_PROXY_HEADERS=

# Netlify only: set NETLIFY=true in the site's environment variables (scope: Functions) so rate limits read
# Netlify's client-address header. Netlify sets it for builds, not reliably for functions, so set it yourself.
NETLIFY=

# Public landing page at /welcome (and as the signed-out home). Off by default: the private build shows guests
# only the sign-in page. Turning it on does not open sign-up; OWNER_EMAILS still decides who can get in.
PUBLIC_LANDING=

# Optional: the early-access button on the landing page links here (a form you own). Without it the button is "Sign in".
WAITLIST_URL=

# Tests only: MARKET_DATA=demo puts every asset on the demo series (no network).
MARKET_DATA=

# Optional: free Alpaca account keys for real US stock and ETF prices. Without them those markets use demo data.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
