{
  "name": "forecast-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "tokens": "python3 ../../replica/design/build_tokens.py && cp ../../replica/design/tokens.css src/styles/tokens.css",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.mts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:api": "tsx --env-file-if-exists=.env.local tests/api.test.mts",
    "e2e:db": "tsx scripts/reset-test-db.mts",
    "e2e": "playwright test",
    "models:compare": "tsx --env-file-if-exists=.env.local scripts/compare-models.mts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "lightweight-charts": "4.2.3",
    "lucide-react": "0.577.0",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@netlify/plugin-nextjs": "5.16.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
