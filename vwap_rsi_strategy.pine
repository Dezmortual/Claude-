//@version=6
indicator("VWAP + RSI Strategy", overlay = true)

emaLen = input.int(20, "EMA Length", minval = 1)
rsiLen = input.int(14, "RSI Length", minval = 1)
rsiMid = input.float(50, "RSI Level", minval = 0, maxval = 100)

vwap = ta.vwap(hlc3)
ema  = ta.ema(close, emaLen)
rsi  = ta.rsi(close, rsiLen)

noVol = ta.cum(nz(volume)) == 0
// VWAP is na until volume prints in the session, EMA/RSI until enough bars exist.
ready = not na(vwap) and not na(ema) and not na(rsi)

longOK  = ready and close > vwap and close > ema and rsi > rsiMid
shortOK = ready and close < vwap and close < ema and rsi < rsiMid

longSig  = barstate.isconfirmed and longOK and not longOK[1]
shortSig = barstate.isconfirmed and shortOK and not shortOK[1]

plot(vwap, "VWAP", color.blue, 2)
plot(ema, "EMA", color.red, 2)

plotshape(longSig, "Long", shape.labelup, location.belowbar, color.green, text = "LONG", textcolor = color.white, size = size.normal)
plotshape(shortSig, "Short", shape.labeldown, location.abovebar, color.red, text = "SHORT", textcolor = color.white, size = size.normal)

var table t = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 15))
if barstate.islast
    table.clear(t, 0, 0, 1, 3)
    if noVol
        table.cell(t, 0, 0, "No volume on this symbol.\nUse BINANCE:BTCUSDT", text_color = color.yellow)
    else if not ready
        table.cell(t, 0, 0, "Waiting for VWAP/EMA/RSI data", text_color = color.yellow)
    else
        g = color.lime
        r = color.red
        table.cell(t, 0, 0, "VWAP", text_color = color.white)
        table.cell(t, 1, 0, close > vwap ? "Above" : "Below", text_color = close > vwap ? g : r)
        table.cell(t, 0, 1, "EMA", text_color = color.white)
        table.cell(t, 1, 1, close > ema ? "Above" : "Below", text_color = close > ema ? g : r)
        table.cell(t, 0, 2, "RSI", text_color = color.white)
        table.cell(t, 1, 2, str.tostring(rsi, "#.0"), text_color = rsi > rsiMid ? g : r)
        table.cell(t, 0, 3, "Bias", text_color = color.white)
        table.cell(t, 1, 3, longOK ? "LONG" : shortOK ? "SHORT" : "WAIT", text_color = longOK ? g : shortOK ? r : color.gray)

alertcondition(longSig, "Long Entry", "VWAP+RSI LONG on {{ticker}} at {{close}}")
alertcondition(shortSig, "Short Entry", "VWAP+RSI SHORT on {{ticker}} at {{close}}")
