//@version=6
// Indicator version of the "Sweep" strategy.
// Long when EMA crosses above VWAP, short when it crosses below.
// Positions exit on an ATR-based trailing stop (activation distance = trail offset),
// emulating strategy.exit(trail_points, trail_offset) on bar highs/lows.
indicator("Sweep Indicator", overlay=true)

atrLen    = input.int(14, "ATR Length", minval=1)
emaLen    = input.int(4, "EMA Length", minval=1)
trailMult = input.float(0.005, "Trail ATR Multiplier", minval=0.0, step=0.001)
showBg    = input.bool(true, "Shade Background While In Position")

grpDash   = "Dashboard"
showDash  = input.bool(true, "Show Dashboard", group=grpDash)
dashPos   = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpDash)
dashSize  = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal"], group=grpDash)
commPct   = input.float(0.05, "Commission % (per side)", minval=0.0, step=0.01, group=grpDash)

atr  = ta.atr(atrLen)
ema  = ta.ema(close, emaLen)
vwap = ta.vwap(close)

longSig  = ta.crossover(ema, vwap)
shortSig = ta.crossunder(ema, vwap)

// Trail distance in price. The strategy places its exit at bar close,
// so the stop active on this bar uses the previous bar's ATR.
trailDist     = atr * trailMult
trailDistPrev = nz(trailDist[1], trailDist)

var int   pos        = 0      // 1 = long, -1 = short, 0 = flat
var float entryPrice = na
var float extreme    = na     // highest high (long) / lowest low (short) since entry
var bool  trailOn    = false
var float stopPrice  = na

bool exitLong  = false
bool exitShort = false
float closedRet = na   // % return of a trade closed on this bar (at most one per bar)

// --- Manage trailing stop for an open position (bars after entry) ---
if pos == 1
    extreme := math.max(extreme, high)
    if not trailOn and extreme >= entryPrice + trailDistPrev
        trailOn := true
    if trailOn
        stopPrice := extreme - trailDistPrev
        if low <= stopPrice
            exitLong  := true
            closedRet := (math.min(open, stopPrice) - entryPrice) / entryPrice * 100 - 2 * commPct
            pos       := 0
else if pos == -1
    extreme := math.min(extreme, low)
    if not trailOn and extreme <= entryPrice - trailDistPrev
        trailOn := true
    if trailOn
        stopPrice := extreme + trailDistPrev
        if high >= stopPrice
            exitShort := true
            closedRet := (entryPrice - math.max(open, stopPrice)) / entryPrice * 100 - 2 * commPct
            pos       := 0

// --- Entries (filled at bar close, like process_orders_on_close=true) ---
bool enterLong  = false
bool enterShort = false

if longSig and pos != 1
    if pos == -1
        exitShort := true
        closedRet := (entryPrice - close) / entryPrice * 100 - 2 * commPct
    enterLong  := true
    pos        := 1
    entryPrice := close
    extreme    := close
    trailOn    := false
    stopPrice  := na
else if shortSig and pos != -1
    if pos == 1
        exitLong  := true
        closedRet := (close - entryPrice) / entryPrice * 100 - 2 * commPct
    enterShort := true
    pos        := -1
    entryPrice := close
    extreme    := close
    trailOn    := false
    stopPrice  := na

if pos == 0
    entryPrice := na
    extreme    := na
    trailOn    := false
    stopPrice  := na

// --- Plots ---
plot(ema,  "EMA",  color=color.orange, linewidth=2)
plot(vwap, "VWAP", color=color.blue,   linewidth=2)
plot(pos != 0 ? entryPrice : na, "Entry Price", color=color.gray, style=plot.style_linebr)
plot(pos == 1 and trailOn ? stopPrice : na,  "Long Trail Stop",  color=color.red,   style=plot.style_linebr, linewidth=2)
plot(pos == -1 and trailOn ? stopPrice : na, "Short Trail Stop", color=color.green, style=plot.style_linebr, linewidth=2)

plotshape(enterLong,  "Long Entry",  shape.triangleup,   location.belowbar, color.green, text="Long",  textcolor=color.green, size=size.small)
plotshape(enterShort, "Short Entry", shape.triangledown, location.abovebar, color.red,   text="Short", textcolor=color.red,   size=size.small)
plotshape(exitLong  and not enterShort, "Long Exit",  shape.xcross, location.abovebar, color.orange, text="LX", textcolor=color.orange, size=size.tiny)
plotshape(exitShort and not enterLong,  "Short Exit", shape.xcross, location.belowbar, color.orange, text="SX", textcolor=color.orange, size=size.tiny)

bgcolor(showBg and pos == 1 ? color.new(color.green, 92) : showBg and pos == -1 ? color.new(color.red, 92) : na)

// --- Trade statistics ---
var int   totalTrades = 0
var int   wins        = 0
var int   losses      = 0
var int   longTrades  = 0
var int   longWins    = 0
var int   shortTrades = 0
var int   shortWins   = 0
var float grossWin    = 0.0
var float grossLoss   = 0.0
var float equity      = 100.0   // compounded, 100% of equity per trade
var float peakEquity  = 100.0
var float maxDD       = 0.0
var int   streak      = 0       // >0 consecutive wins, <0 consecutive losses
var int   maxWinStrk  = 0
var int   maxLossStrk = 0

if not na(closedRet)
    bool wasLong = exitLong
    bool isWin   = closedRet > 0
    totalTrades += 1
    if wasLong
        longTrades += 1
        longWins   += isWin ? 1 : 0
    else
        shortTrades += 1
        shortWins   += isWin ? 1 : 0
    if isWin
        wins     += 1
        grossWin += closedRet
        streak   := streak > 0 ? streak + 1 : 1
    else
        losses    += 1
        grossLoss += math.abs(closedRet)
        streak    := streak < 0 ? streak - 1 : -1
    maxWinStrk  := math.max(maxWinStrk, streak)
    maxLossStrk := math.max(maxLossStrk, -streak)
    equity      := equity * (1 + closedRet / 100)
    peakEquity  := math.max(peakEquity, equity)
    maxDD       := math.max(maxDD, (peakEquity - equity) / peakEquity * 100)

// --- Dashboard ---
pct(x) => na(x) ? "n/a" : str.tostring(x, "#.##") + "%"
rate(int w, int n) => n > 0 ? float(w) / n * 100.0 : na
pnlColor(x) => na(x) ? color.gray : x >= 0 ? color.green : color.red

tblPos = switch dashPos
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right
txtSize = switch dashSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table dash = table.new(tblPos, 2, 15, bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 60), border_width=1)

addRow(int r, string label, string value, color valColor) =>
    table.cell(dash, 0, r, label, text_color=color.silver, text_size=txtSize, text_halign=text.align_left)
    table.cell(dash, 1, r, value, text_color=valColor,     text_size=txtSize, text_halign=text.align_right)

if showDash and barstate.islast
    float winRate  = rate(wins, totalTrades)
    float netPnl   = equity - 100.0
    float pf       = grossLoss > 0 ? grossWin / grossLoss : na
    float avgWin   = wins > 0 ? grossWin / wins : na
    float avgLoss  = losses > 0 ? -grossLoss / losses : na
    float avgTrade = totalTrades > 0 ? (grossWin - grossLoss) / totalTrades : na
    float openPnl  = pos == 1 ? (close - entryPrice) / entryPrice * 100 : pos == -1 ? (entryPrice - close) / entryPrice * 100 : na
    string posTxt  = pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT"
    color  posCol  = pos == 1 ? color.green : pos == -1 ? color.red : color.gray

    table.cell(dash, 0, 0, "Sweep Stats", text_color=color.white, text_size=txtSize, bgcolor=color.new(color.blue, 40))
    table.cell(dash, 1, 0, "", bgcolor=color.new(color.blue, 40))
    table.merge_cells(dash, 0, 0, 1, 0)
    addRow(1,  "Total Trades",   str.tostring(totalTrades), color.white)
    addRow(2,  "Wins / Losses",  str.tostring(wins) + " / " + str.tostring(losses), color.white)
    addRow(3,  "Win Rate",       pct(winRate), na(winRate) ? color.gray : winRate >= 50 ? color.green : color.red)
    addRow(4,  "Long Win Rate",  pct(rate(longWins, longTrades)) + " (" + str.tostring(longTrades) + ")", color.white)
    addRow(5,  "Short Win Rate", pct(rate(shortWins, shortTrades)) + " (" + str.tostring(shortTrades) + ")", color.white)
    addRow(6,  "Net P&L",        pct(netPnl), pnlColor(netPnl))
    addRow(7,  "Profit Factor",  na(pf) ? "n/a" : str.tostring(pf, "#.##"), na(pf) ? color.gray : pf >= 1 ? color.green : color.red)
    addRow(8,  "Avg Trade",      pct(avgTrade), pnlColor(avgTrade))
    addRow(9,  "Avg Win",        pct(avgWin), color.green)
    addRow(10, "Avg Loss",       pct(avgLoss), color.red)
    addRow(11, "Max Drawdown",   pct(-maxDD), maxDD > 0 ? color.red : color.gray)
    addRow(12, "Max Win/Loss Streak", str.tostring(maxWinStrk) + " / " + str.tostring(maxLossStrk), color.white)
    addRow(13, "Position",       posTxt, posCol)
    addRow(14, "Open P&L",       pct(openPnl), pnlColor(openPnl))

// --- Alerts ---
alertcondition(enterLong,  "Long Entry",  "Sweep: Long entry on {{ticker}} at {{close}}")
alertcondition(enterShort, "Short Entry", "Sweep: Short entry on {{ticker}} at {{close}}")
alertcondition(exitLong,   "Long Exit",   "Sweep: Long exit on {{ticker}}")
alertcondition(exitShort,  "Short Exit",  "Sweep: Short exit on {{ticker}}")
